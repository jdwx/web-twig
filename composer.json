{
  "name": "jdwx/web-twig",
  "description": "Integrate twig templates with jdwx/web and jdwx/panels.",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "JDWX\\Twig\\Web\\": "src/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.3.0",
    "jdwx/panels": "dev-main",
    "jdwx/twig": "^2.0",
    "jdwx/web": "^3.0",
    "jdwx/web-framework": "^1.0"
  },
  "require-dev": {
    "jetbrains/phpstorm-attributes": "^1.0",
    "phan/phan": "^v5",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12"
  },
  "scripts": {
    "phan": "PHAN_ALLOW_XDEBUG=1 php -d xdebug.mode=off vendor/bin/phan --no-progress-bar -S --analyze-twice",
    "phpstan": "php -d xdebug.so vendor/bin/phpstan --no-progress",
    "test": "vendor/bin/phpunit tests"
  }
}